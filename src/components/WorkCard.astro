---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  img: ImageMetadata;
  slug: string;
  type?: string;
  collection?: string;
  model?: string;
  concept?: string;
  year?: string;
}
const { img, slug, type, collection, model, concept, year } = Astro.props;
const ar = img.width && img.height ? img.width / img.height : 1;

// Back-of-card lines: one info piece per line, blanks omitted.
// Concept + year share a line (e.g. "Fotos para empresa_ejemplo 2025").
const conceptLine = [concept, year].filter(Boolean).join(' ');
const lines = [type, collection, model, conceptLine].filter(Boolean) as string[];
---

<figure class="work" style={`--ar:${ar.toFixed(4)}`}>
  <div class="flip">
    <div class="face front">
      <Image
        src={img}
        alt={type ?? slug}
        widths={[480, 768, 1200, 1600]}
        sizes="(max-width: 768px) 92vw, 60vw"
        loading="lazy"
      />
    </div>
    <div class="face back">
      {lines.map((l, i) => <p class={i === 0 ? 'lead' : ''}>{l}</p>)}
    </div>
  </div>
</figure>
