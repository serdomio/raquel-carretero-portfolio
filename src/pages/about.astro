---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RichText from '../components/RichText.astro';
import { site } from '../data/content';
---

<Base title={`About — ${site.name}`}>
  <main class="px-6 md:px-8 pt-[18vh] pb-24 max-w-prose mx-auto">
    <a href="/" class="font-serif text-2xl font-light tracking-tight text-ink">{site.name}</a>
    <RichText content={site.about} class="mt-8 text-base leading-relaxed text-ink/85" />
    <p class="mt-8 text-xs uppercase tracking-[0.16em] text-muted">
      <a href={`mailto:${site.email}`} class="transition-colors hover:text-ink">{site.email}</a>
    </p>
  </main>
  <SiteFooter />
</Base>
