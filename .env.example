# TinaCMS Cloud — Phase 2 (remote editing for Raquel).
# Copy to `.env` and fill from your Tina Cloud project (app.tina.io).
# LOCAL mode (npm run dev) needs NONE of these — leave them unset and Tina runs
# offline against the local GraphQL server. These are only for the hosted admin.

# Public client id of your Tina Cloud project (safe to expose to the browser).
TINA_PUBLIC_CLIENT_ID=

# Read/write token for content (KEEP SECRET — set in Netlify env, never commit .env).
TINA_TOKEN=

# Git branch Tina reads/writes content on (must match the deployed branch).
TINA_BRANCH=main
